    // PCM rules are appended to the existing pay rules without changing them.
    function pcmRole() {
      return request.auth != null ? get(/databases/$(database)/documents/pcm_access/$(request.auth.uid)).data.role : '';
    }
    function pcmRead() { return pcmRole() in ['reader','editor','admin','publisher']; }
    function pcmWrite() { return pcmRole() in ['editor','admin','publisher']; }
    function pcmPublish() { return pcmRole() in ['admin','publisher']; }
    function pcmPatient(id) { return id.matches('^[a-f0-9]{24}$') && exists(/databases/$(database)/documents/pcm_patients/$(id)); }
    function pcmMonth(period) { return period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'); }
    function pcmText(values,key) { return !(key in values) || (values[key] is string && values[key].size() <= 4000); }
    function pcmValues(values,period) {
      return values is map
        && values.keys().hasOnly(period == 'enrollment' ? ['status','assigned_to','next_action','notes','billing_practitioner','follow_up'] : ['status','assigned_to','next_action','notes'])
        && values.keys().hasAll(['status'])
        && (period == 'enrollment' ? values.status in ['candidate','review','outreach','enrolled','paused','declined'] : values.status in ['not_started','in_progress','complete','ready_to_bill','submitted'])
        && pcmText(values,'assigned_to') && pcmText(values,'next_action') && pcmText(values,'notes')
        && pcmText(values,'billing_practitioner') && pcmText(values,'follow_up')
        && (!('follow_up' in values) || values.follow_up == '' || values.follow_up.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    match /pcm_access/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || pcmRole() == 'admin');
      allow list: if pcmRole() == 'admin';
      allow create, update: if pcmRole() == 'admin' && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['reader','editor','admin','publisher'];
      allow delete: if pcmRole() == 'admin' && request.auth.uid != uid;
    }
    match /pcm_publication/{id} { allow read: if pcmRead(); allow write: if pcmPublish(); }
    match /pcm_sources/{id} { allow read: if pcmRead(); allow create: if pcmPublish(); }
    match /pcm_patients/{id} { allow read: if pcmRead(); allow create, update: if pcmPublish(); }
    match /pcm_members/{id} {
      allow read: if pcmRead();
      allow create: if pcmWrite() && pcmPatient(id)
        && request.resource.data.keys().hasOnly(['patient','recorded_by','updated'])
        && request.resource.data.patient == get(/databases/$(database)/documents/pcm_patients/$(id)).data.patient
        && request.resource.data.recorded_by == request.auth.uid && request.resource.data.updated == request.time;
    }
    match /pcm_workflow/{id} {
      function valid() {
        let d = request.resource.data;
        let c = getAfter(/databases/$(database)/documents/pcm_changes/$(id + '__' + string(d.revision))).data;
        return pcmWrite() && pcmPatient(d.patientId) && (d.period == 'enrollment' || pcmMonth(d.period))
          && id == d.patientId + '__' + d.period
          && d.keys().hasOnly(['patientId','period','values','revision','recorded_by','updated'])
          && d.revision is int && d.revision > 0 && pcmValues(d.values,d.period)
          && d.recorded_by == request.auth.uid && d.updated == request.time
          && c.current == d.values && c.recorded_by == d.recorded_by && c.occurred == request.time;
      }
      allow read: if pcmRead();
      allow create: if valid() && request.resource.data.revision == 1;
      allow update: if valid() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /pcm_changes/{id} {
      function validChange() {
        let d = request.resource.data;
        let key = d.patientId + '__' + d.period;
        let path = /databases/$(database)/documents/pcm_workflow/$(key);
        let after = getAfter(path).data;
        let previous = exists(path) ? get(path).data.values : {'status': d.period == 'enrollment' ? 'candidate' : 'not_started'};
        return pcmWrite() && id == key + '__' + string(d.revision)
          && d.keys().hasOnly(['patientId','period','previous','current','revision','recorded_by','occurred'])
          && d.current == after.values && d.previous == previous && d.revision == after.revision
          && d.recorded_by == request.auth.uid && d.occurred == request.time;
      }
      allow read: if pcmRead();
      allow create: if validChange();
    }
    match /pcm_activities/{id} {
      allow read: if pcmRead();
      allow create: if pcmWrite() && pcmPatient(request.resource.data.patientId)
        && id.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
        && request.resource.data.keys().hasOnly(['patientId','patientMonth','period','actor','minutes','note','recorded_by','occurred'])
        && pcmMonth(request.resource.data.period)
        && request.resource.data.patientMonth == request.resource.data.patientId + ':' + request.resource.data.period
        && request.resource.data.actor is string && request.resource.data.actor.size() > 0 && request.resource.data.actor.size() <= 120
        && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1440
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 4000
        && request.resource.data.recorded_by == request.auth.uid && request.resource.data.occurred == request.time;
    }
